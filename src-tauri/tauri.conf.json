{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex Tools",
  "version": "3.2.1",
  "identifier": "com.carry.codex-tools",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Tools",
        "width": 1586,
        "height": 992,
        "minWidth": 640,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "gen/remote-build",
      "WebView2Loader.dll"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "pubkey": "",
      "endpoints": [
        "https://github.com/CleoCheng/codex-tools/releases/latest/download/latest.json"
      ]
    }
  }
}
